---
/**
 * Project detail page — English locale.
 *
 * El proyecto se resuelve aquí y no en ProjectSlugPage porque solo la página
 * puede fijar el status HTTP:
 * - slug inexistente → 404 real. Antes caía en datos de ejemplo con 200, así
 *   que cualquier /project/loquesea era una URL indexable (soft 404).
 * - Payload caído → 503 + Retry-After: Google reintenta en vez de desindexar
 *   los proyectos reales por una caída temporal del CMS.
 */
import ProjectSlugPage from "@/components/pages/ProjectSlugPage.astro";
import { PayloadAPI, type PayloadProject } from "@/lib/payload";

export const prerender = false;

let project: PayloadProject | undefined;
try {
  const projects = await PayloadAPI.getProjects("en");
  project = projects.find((p) => p.slug === Astro.params.slug);
} catch (error) {
  console.error("Error fetching project:", error);
  return new Response("Servicio no disponible temporalmente", {
    status: 503,
    headers: { "Retry-After": "300" },
  });
}

if (!project) return Astro.rewrite("/404");
---

<ProjectSlugPage project={project} />
