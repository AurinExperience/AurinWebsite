---
/**
 * City web design landings — English locale.
 * URL: /en/web-design-<city>
 *
 * Same closed list as the Spanish route: anything not in src/data/landings
 * returns a real 404 instead of rendering a page.
 */
import { findLanding } from '@/data/landings';
import { findSector } from '@/data/sectors';
import WebDesignCityPage from '@/components/pages/WebDesignCityPage.astro';
import WebDesignSectorPage from '@/components/pages/WebDesignSectorPage.astro';

// Industry pages share the URL prefix (/en/web-design-for-doctors).
const landing = findLanding(Astro.params.city, 'en');
const sector = landing ? undefined : findSector(Astro.params.city, 'en');
if (!landing && !sector) return Astro.rewrite('/404');
---

{landing ? <WebDesignCityPage landing={landing} /> : <WebDesignSectorPage sector={sector!} />}
