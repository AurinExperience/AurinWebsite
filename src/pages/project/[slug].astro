---
/**
 * Project detail page — Spanish (default locale).
 */
import ProjectSlugPage from "@/components/pages/ProjectSlugPage.astro";
import { loadProjectBySlug } from "@/lib/project-page";

export const prerender = false;

const result = await loadProjectBySlug(Astro.params.slug, "es");

if (result === "error") {
  return new Response("Servicio no disponible temporalmente", {
    status: 503,
    headers: { "Retry-After": "300" },
  });
}

if (result === "not-found") return Astro.rewrite("/404");

const { project, sibling, alternateLinks } = result;
---

<ProjectSlugPage project={project} sibling={sibling} alternateLinks={alternateLinks} />
