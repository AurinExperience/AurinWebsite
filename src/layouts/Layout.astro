---
import '@/styles/global.css';
import { getLangFromUrl } from '@/i18n';
import MegaMenu from '@/components/layout/MegaMenu.astro';
import AdvancedSEO from '@/blocks/shared/SEO/AdvancedSEO.astro';
import GlobalSchema from '@/blocks/shared/SEO/GlobalSchema.astro';
{/* import PageLoader from '@/components/layout/PageLoader.astro'; */}
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

import Vignette from '@/components/ui/Vignette.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const currentLang = getLangFromUrl(Astro.url);

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: string;
	structuredData?: object;
	additionalStructuredData?: object[];
	keywords?: string;
	author?: string;
	twitterCard?: string;
	vignetteIntensity?: 'light' | 'medium' | 'strong';
	vignetteColor?: string;
	showVignette?: boolean;
	noindex?: boolean;
	alternateLinks?: { hreflang: string; href: string }[];
	/* Landings de captura: sin MegaMenu, para no dar salidas de la página. */
	showMegaMenu?: boolean;
	/* WhatsApp es +52: en las landings en inglés de EE. UU. se oculta. */
	showWhatsApp?: boolean;
}

const { 
	title,
	description,
	canonical,
	ogImage,
	ogType,
	structuredData,
	additionalStructuredData,
	keywords,
	author,
	twitterCard,
	vignetteIntensity = 'medium',
	vignetteColor,
	showVignette = false,
	noindex = false,
	alternateLinks,
	showMegaMenu = true,
	showWhatsApp = true
} = Astro.props;
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		
		<!-- Browser toolbar color customization -->
		<meta name="theme-color" content="#d0df00" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- Favicon configuration -->
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		
		<!-- Web App Manifest -->
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		{/* Fuentes auto-hospedadas (ver scripts/localize-fonts.mjs). Antes se
		     encadenaban dos orígenes antes de poder pintar texto con la tipografía
		     real: HTML -> fonts.googleapis.com (el CSS) -> fonts.gstatic.com (los
		     woff2). Ahora salen del mismo origen, sobre la conexión ya abierta.
		     Se precarga solo Clarity City: es la fuente del cuerpo y la del elemento
		     que Lighthouse marca como LCP en las landings. */}
		<link
			rel="preload"
			href="/fonts/clarity-city-100-900-normal-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- SEO Avanzado -->
		<AdvancedSEO 
			title={title}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogType={ogType}
			structuredData={structuredData}
			additionalStructuredData={additionalStructuredData}
			keywords={keywords}
			author={author}
			twitterCard={twitterCard}
			noindex={noindex}
			alternateLinks={alternateLinks}
		/>
		<GlobalSchema />
		{/* Google tag (gtag.js) — diferido.
		     Cargado en el <head> se comía ~2.2 s de CPU y bloqueaba el hilo principal
		     justo cuando el navegador debía pintar el LCP. El dataLayer queda listo de
		     inmediato, así que cualquier gtag() temprano se encola y se procesa cuando
		     el script llega: la analítica no pierde eventos, solo deja pasar el render. */}
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-CQTWM27WDC');

			(function () {
				var loaded = false;
				function loadGtag() {
					if (loaded) return;
					loaded = true;
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-CQTWM27WDC';
					document.head.appendChild(s);
				}
				var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
				events.forEach(function (e) {
					addEventListener(e, loadGtag, { once: true, passive: true });
				});
				// Red de seguridad: si nadie interactúa, cargar en el primer hueco de CPU
				// después de load (o a los 3 s en navegadores sin requestIdleCallback).
				addEventListener('load', function () {
					if (window.requestIdleCallback) requestIdleCallback(loadGtag, { timeout: 3000 });
					else setTimeout(loadGtag, 3000);
				});
			})();
		</script>
		{/* Microsoft Clarity — snippet oficial, se inyecta async.
		     A diferencia de gtag no se difiere: Clarity graba la sesión desde el
		     primer frame, y esperar a la primera interacción perdería justo el
		     tramo de carga que interesa ver en los replays y heatmaps. */}
		<script is:inline>
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window, document, "clarity", "script", "y4d5j1lbfv");
		</script>
		{/* Atribución de leads. El referrer al enviar un formulario es casi siempre la
		     página anterior del propio sitio; lo que importa es cómo llegó la persona
		     la primera vez (Google, ChatGPT, un anuncio…). Se guarda esa llegada y se
		     reemplaza solo si entra por otra campaña (utm/gclid/fbclid).
		     window.aurinLead(evento?, lead?) arma el lead con un ID único que viaja
		     al correo y a GA4/Clarity, para poder cruzar un correo con su sesión. */}
		<script is:inline>
			(function () {
				var KEY = 'aurin-attribution';
				var q = new URLSearchParams(location.search);
				var ref = '';
				try { if (document.referrer && new URL(document.referrer).host !== location.host) ref = document.referrer; } catch (e) {}
				var refHost = ref ? new URL(ref).host.replace(/^www\./, '') : '';
				var paid = q.get('gclid') ? 'google' : q.get('fbclid') ? 'facebook' : '';
				var attr = null;
				try { attr = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
				if (!attr || q.get('utm_source') || paid) {
					attr = {
						first_source: q.get('utm_source') || paid || refHost || 'directo',
						first_medium: q.get('utm_medium') || (paid ? 'cpc'
							: /google\.|bing\.|yahoo\.|duckduckgo\.|ecosia\./.test(refHost) ? 'organic'
							: /chatgpt\.|openai\.|perplexity\.|claude\.ai|gemini\.|copilot\./.test(refHost) ? 'ia'
							: refHost ? 'referral' : 'none'),
						first_campaign: q.get('utm_campaign') || '',
						first_landing: location.pathname + location.search,
						first_referrer: ref,
						first_visit: new Date().toISOString(),
					};
					try { localStorage.setItem(KEY, JSON.stringify(attr)); } catch (e) {}
				}

				window.aurinLead = function (event, lead) {
					lead = lead || Object.assign({
						lead_id: (Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6)).toUpperCase(),
						form_page: location.pathname,
					}, attr);
					if (event) {
						// GA4 corta los parámetros a 100 caracteres; el referrer completo va solo al correo
						var params = { transport_type: 'beacon' };
						for (var k in lead) if (k !== 'first_referrer' && lead[k]) params[k] = String(lead[k]).slice(0, 100);
						window.gtag && gtag('event', event, params);
						window.clarity && clarity('set', 'lead_id', lead.lead_id);
						window.clarity && clarity('event', event);
					}
					return lead;
				};

				// Quién empezó a llenar un formulario de contacto (data-lead-form), para
				// medir abandono contra los envíos
				var started = new WeakSet();
				document.addEventListener('focusin', function (e) {
					var form = e.target.closest && e.target.closest('form[data-lead-form]');
					if (!form || started.has(form)) return;
					started.add(form);
					window.gtag && gtag('event', 'form_start', { form_id: form.dataset.leadForm, form_page: location.pathname });
				});
			})();
		</script>
	</head>
	<body>
		{/* <PageLoader /> */}
		{showMegaMenu && <MegaMenu />}
		<slot />
		{showVignette && (
			<Vignette 
				intensity={vignetteIntensity}
				color={vignetteColor}
			/>
		)}
		{showWhatsApp && <WhatsAppButton />}
		<SpeedInsights />
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	
	html {
		font-family: 'Clarity City', -apple-system, BlinkMacSystemFont, sans-serif;
		background: #000000;
		overflow-x: clip;
	}

	body {
		margin: 0;
		padding: 0;
		overflow-x: clip;
		width: 100%;
	}
	
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
</style>
