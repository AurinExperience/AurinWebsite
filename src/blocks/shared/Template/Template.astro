---
/**
 * Template — Project detail content block.
 * Renders the project banner (logo, title, services) and then the CMS "Secciones" in their
 * order: image, text, device (laptop, tablet or phone whose screen scrolls through
 * screenshots) and gallery (slider or masonry). Any of them can repeat or be missing.
 * Layout shell (Header, Footer, Vignette, etc.) is owned by the page component.
 */
import ProjectBanner from "@/blocks/projects/ProjectBanner/ProjectBanner.astro";
import GalleryCarousel from "@/components/projects/carousel/GalleryCarousel";
import { getLangFromUrl } from "@/i18n/utils";
import { translations } from "@/i18n/translations";
import type { Section } from "@/lib/project-page";
import ChevronLeft from "lucide-astro/ChevronLeft";
import ChevronRight from "lucide-astro/ChevronRight";
import X from "lucide-astro/X";
import styles from "./Template.module.css";

interface ProjectTemplateProps {
  projectTitle: string;
  projectCategories: string[];
  projectDescription?: string;
  clientLogo?: string;
  logoScale?: number;
  logoColor?: string;
  sections: Section[];
}

interface Props {
  projectData: ProjectTemplateProps;
}

const { projectData } = Astro.props;
const t = translations[getLangFromUrl(Astro.url)].projects.gallery;

type GalleryImage = Extract<Section, { type: "gallery" }>["images"][number];

// Masonry: cada foto va a la columna más corta (por su proporción), así se lee de izquierda
// a derecha. Se usan las columnas que dejen el mosaico parejo (hasta 3 en escritorio, 2 en
// celular); el CSS muestra una versión. Parejo = las fotos se estiran un poco para que todas
// las columnas terminen a la misma altura, sin huecos abajo.
// index = orden del CMS: el slide de la imagen ampliada lo sigue aunque el mosaico las acomode distinto
const masonry = (images: GalleryImage[], count: number) => {
  const gallery = images.map((image, index) => ({ ...image, index }));
  const columns = Array.from({ length: Math.min(gallery.length, count) }, () => ({ height: 0, images: [] as typeof gallery }));
  for (const image of gallery) {
    const shortest = columns.reduce((a, b) => (b.height < a.height ? b : a));
    shortest.images.push(image);
    shortest.height += image.width && image.height ? image.height / image.width : 1;
  }
  const heights = columns.map((column) => column.height);
  return { columns, even: Math.min(...heights) / Math.max(...heights) >= 0.75 };
};
// ponytail: con fotos muy dispares ni 2 columnas quedan parejas; se dejan sin estirar para no recortar de más
const bestMasonry = (images: GalleryImage[], max: number) => {
  const options = Array.from({ length: max - 1 }, (_, i) => masonry(images, max - i));
  return options.find((option) => option.even) ?? options[options.length - 1];
};
const galleryLayouts = (images: GalleryImage[]) => [
  { ...bestMasonry(images, 3), className: styles.galleryDesktop },
  { ...bestMasonry(images, 2), className: styles.galleryMobile },
];
const hasMasonry = projectData.sections.some((section) => section.type === "gallery" && section.layout === "masonry");

// Dispositivo: sus fotos en una tira dentro de la pantalla; cuántas pantallas mide la tira alarga el scroll
const SCREEN_RATIO = { laptop: 16 / 10, tablet: 3 / 4, phone: 9 / 19.5 }; // ancho / alto, igual que el CSS
// A los lados, una pantalla por captura
const devicePages = ({ device, horizontal, images }: Extract<Section, { type: "device" }>) =>
  horizontal
    ? images.length
    : images.reduce((sum, image) => sum + (image.width && image.height ? image.height / image.width : 1), 0) * SCREEN_RATIO[device];
// Láminas que forman el grosor (16, igual que el CSS)
const sideLayers = Array.from({ length: 16 }, (_, i) => i + 1);
// Botones del canto: lado, dónde empiezan y largo (% del alto del cuerpo)
const DEVICE_BUTTONS = {
  laptop: [],
  tablet: [
    { side: "Right", at: 7, length: 8 },
    { side: "Right", at: 18, length: 6 },
    { side: "Right", at: 26, length: 6 },
  ],
  phone: [
    { side: "Left", at: 17, length: 5 },
    { side: "Left", at: 25, length: 10 },
    { side: "Left", at: 37, length: 10 },
    { side: "Right", at: 27, length: 15 },
  ],
};
// Láminas de cada botón (8, igual que el CSS); --round recorta las puntas en curva hacia el frente y atrás
const buttonLayers = Array.from({ length: 8 }, (_, layer) => {
  const t = ((layer + 0.5) / 8) * 2 - 1;
  return { layer, round: 1 - Math.sqrt(1 - t * t) };
});
---

<article class={styles.projectTemplate}>
  <ProjectBanner
    title={projectData.projectTitle}
    categories={projectData.projectCategories}
    clientLogo={projectData.clientLogo}
    logoScale={projectData.logoScale}
    logoColor={projectData.logoColor}
  />

  <section class={styles.contentSection}>
    <div class={styles.contentContainer}>
      {projectData.sections.map((section) => {
        if (section.type === "image") {
          return (
            <div class={styles.sectionImage} style={`--hero-scale: ${section.scale}`}>
              <img src={section.imgUrl} alt={section.alt} />
            </div>
          );
        }

        if (section.type === "text") {
          return (
            <Fragment>
              {section.heading.trim() && <div class={styles.sectionHeading} set:html={section.heading} />}
              {section.body.trim() && <div class={styles.descriptionText} set:html={section.body} />}
            </Fragment>
          );
        }

        if (section.type === "device") {
          const { device, horizontal, images } = section;
          return (
            <div
              class={styles.deviceScroll}
              style={`--device-pages: ${devicePages(section).toFixed(2)}`}
              data-device
              data-device-screens={horizontal ? images.length : undefined}
            >
              <div class={styles.deviceSticky}>
                <div class:list={[styles.device, styles[device]]}>
                  <div class={styles.deviceBody}>
                    <div class={styles.deviceSide}>{sideLayers.map((layer) => <span style={`--layer: ${layer}`} />)}</div>
                    {DEVICE_BUTTONS[device].map(({ side, at, length }) => (
                      <span class:list={[styles.deviceButton, styles[`button${side}`]]} style={`--at: ${at}%; --length: ${length}%`}>
                        {buttonLayers.map(({ layer, round }) => <span style={`--layer: ${layer}; --round: ${round.toFixed(3)}`} />)}
                      </span>
                    ))}
                    <div class={styles.deviceScreen}>
                      <div class:list={[styles.deviceStrip, horizontal && styles.deviceStripHorizontal]}>
                        {images.map((image) => (
                          <img src={image.imgUrl} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
                        ))}
                      </div>
                    </div>
                    {device === "laptop" && (
                      <div class={styles.laptopBase}>
                        <div class={styles.laptopHinge} />
                        <div class={styles.deviceSide}>{sideLayers.map((layer) => <span style={`--layer: ${layer}`} />)}</div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        }

        if (section.layout === "slider") {
          return <GalleryCarousel client:visible data={section.images} height={section.height} />;
        }

        return (
          <div data-gallery>
            {galleryLayouts(section.images).map(({ columns, even, className }) => (
              <div class:list={[styles.gallery, className, { [styles.galleryEven]: even }]}>
                {columns.map((column) => (
                  <div class={styles.galleryColumn}>
                    {column.images.map((image) => (
                      <button
                        type="button"
                        class={styles.galleryOpen}
                        data-lightbox={image.index}
                        data-caption={image.caption}
                        aria-label={`${t.expand}: ${image.alt}`}
                      >
                        <img
                          src={image.imgUrl}
                          alt={image.alt}
                          width={image.width}
                          height={image.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </button>
                    ))}
                  </div>
                ))}
              </div>
            ))}
          </div>
        );
      })}
    </div>
  </section>

  {hasMasonry && (
    <dialog class={styles.lightbox} data-lightbox-dialog>
      <form method="dialog">
        <button class={styles.lightboxClose} aria-label={t.close}><X /></button>
      </form>
      <button type="button" class:list={[styles.lightboxNav, styles.lightboxPrev]} data-lightbox-step="-1" aria-label={t.prev}>
        <ChevronLeft />
      </button>
      <figure class={styles.lightboxFigure}>
        <img class={styles.lightboxImage} alt="" />
        <figcaption class={styles.lightboxCaption}>
          <span class={styles.lightboxCounter}></span>
          <span class={styles.lightboxText}></span>
        </figcaption>
      </figure>
      <button type="button" class:list={[styles.lightboxNav, styles.lightboxNext]} data-lightbox-step="1" aria-label={t.next}>
        <ChevronRight />
      </button>
    </dialog>
  )}
</article>

<script>
  // Imagen ampliada como slide. Todo delegado en document: sigue funcionando cuando el
  // live preview reemplaza la galería. Las fotos van en el orden del CMS (data-lightbox), solo
  // las de la galería que se abrió (puede haber varias en la página).
  let items: HTMLElement[] = [];
  let current = 0;
  let swipeX: number | null = null;

  const dialog = () => document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");

  function show(index: number) {
    const box = dialog();
    if (!box || items.length === 0) return;
    current = (index + items.length) % items.length;
    const source = items[current].querySelector("img")!;
    const image = box.querySelector("img")!;
    image.src = source.currentSrc || source.src;
    image.alt = source.alt;
    box.querySelector("figcaption span:first-child")!.textContent = items.length > 1 ? `${current + 1} / ${items.length}` : "";
    box.querySelector("figcaption span:last-child")!.textContent = items[current].dataset.caption ?? "";
    box.toggleAttribute("data-single", items.length < 2);
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const box = dialog();
    if (!box) return;
    const open = target.closest<HTMLElement>("[data-lightbox]");
    const step = target.closest<HTMLElement>("[data-lightbox-step]");
    if (open) {
      // Solo la versión visible del mosaico (escritorio o celular), sin repetidas
      items = [...open.closest("[data-gallery]")!.querySelectorAll<HTMLElement>("[data-lightbox]")]
        .filter((item) => item.offsetParent !== null)
        .sort((a, b) => Number(a.dataset.lightbox) - Number(b.dataset.lightbox));
      show(items.indexOf(open));
      box.showModal();
    } else if (step) {
      show(current + Number(step.dataset.lightboxStep));
    } else if (target === box) {
      box.close(); // clic en el fondo
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!dialog()?.open) return;
    if (event.key === "ArrowLeft") show(current - 1);
    if (event.key === "ArrowRight") show(current + 1);
  });

  // Deslizar con el dedo en celular
  document.addEventListener("pointerdown", (event) => {
    if (dialog()?.open && event.pointerType !== "mouse") swipeX = event.clientX;
  });
  document.addEventListener("pointerup", (event) => {
    if (swipeX === null) return;
    const dx = event.clientX - swipeX;
    swipeX = null;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });

  // Dispositivo, coreografía tipo Apple medida en px de scroll desde que se fija arriba:
  // - entrada (--device-intro): empieza cuando la sección ya se ve casi entera y termina tras media
  //   pantalla fijo (los 50svh extra de .deviceScroll);
  // - captura (--device-scroll): el resto del tramo fijo.
  // Las dos con curva suave de entrada y salida. Sigue al scroll con inercia (12 % por cuadro) para
  // moverse como algo con peso. Con "reducir movimiento" no hay entrada.
  const smoothed = new WeakMap<HTMLElement, number>();
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const ease = (t: number) => t * t * (3 - 2 * t);
  let ticking = false;
  function scrollDevices() {
    let moving = false;
    // Alto sin la barra del navegador: innerHeight cambia cuando el celular la esconde y el dispositivo daba un salto
    const viewport = document.documentElement.clientHeight;
    for (const device of document.querySelectorAll<HTMLElement>("[data-device]")) {
      const { top, height } = device.getBoundingClientRect();
      const target = -top;
      const previous = smoothed.get(device) ?? target;
      const next = Math.abs(target - previous) < 0.5 ? target : previous + (target - previous) * 0.12;
      smoothed.set(device, next);
      const intro = calm ? 1 : ease(clamp((next + 0.4 * viewport) / (0.9 * viewport)));
      const progress = clamp((next - 0.5 * viewport) / (height - 1.5 * viewport));
      // A los lados: se queda un momento en cada captura y desliza a la siguiente
      const steps = Number(device.dataset.deviceScreens) - 1;
      const step = Math.min(Math.floor(progress * steps), steps - 1);
      const scroll = steps > 0 ? (step + ease(clamp((progress * steps - step - 0.2) / 0.6))) / steps : ease(progress);
      device.style.setProperty("--device-intro", intro.toFixed(4));
      device.style.setProperty("--device-scroll", scroll.toFixed(4));
      moving ||= next !== target;
    }
    ticking = moving;
    if (moving) requestAnimationFrame(scrollDevices);
  }
  addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(scrollDevices);
    },
    { passive: true }
  );
  scrollDevices();
</script>
