---
import { getLangFromUrl, getLocalizedPath } from "@/i18n";
import { SITE } from "@/config/site";

export interface AlternateLink {
  hreflang: string;
  href: string;
}

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object;
  additionalStructuredData?: object[];
  keywords?: string;
  author?: string;
  twitterCard?: string;
  alternateLinks?: AlternateLink[];
  noindex?: boolean;
}

const {
  title,
  description = "Aurin User Experts",
  canonical,
  ogImage = SITE.ogImage,
  ogType = "website",
  structuredData,
  additionalStructuredData,
  keywords,
  author = "Aurin",
  twitterCard = "summary_large_image",
  alternateLinks,
  noindex = false,
} = Astro.props;

const siteUrl = (Astro.site?.href || "https://aurin.mx").replace(/\/$/, "");
const canonicalURL = canonical || `${siteUrl}${Astro.url.pathname}`;

// og:locale tiene que seguir al idioma de la página: hardcodeado a es_MX,
// las páginas /en/ se anunciaban en español a Facebook y LinkedIn.
const ogLocale = getLangFromUrl(Astro.url) === "en" ? "en_US" : "es_MX";
const ogLocaleAlternate = ogLocale === "en_US" ? "es_MX" : "en_US";

// Las rutas con slug distinto por idioma viven en getLocalizedPath, que es
// también lo que usa el botón de idioma del Header.
const esPath = getLocalizedPath(Astro.url.pathname, "es");
const enPath = getLocalizedPath(Astro.url.pathname, "en");

const alternateEsUrl = `${siteUrl}${esPath}`;
const alternateEnUrl = `${siteUrl}${enPath}`;

const resolvedAlternateLinks = alternateLinks || [
  { hreflang: "es", href: alternateEsUrl },
  { hreflang: "en", href: alternateEnUrl },
  { hreflang: "x-default", href: alternateEsUrl },
];
---

<!-- Meta Tags Básicos -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}
<link rel="canonical" href={canonicalURL} />

<!-- Alternativas de Idioma (hreflang) -->
{
  resolvedAlternateLinks.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
  ))
}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<!-- Sin dimensiones, varios scrapers no pintan la preview en el primer rastreo. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Aurin" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<!-- Twitter Card -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- Search Console -->
<meta
  name="google-site-verification"
  content="kZkzlDt5cgsTMRFgu6fNAZO7XrP0wPhczT-8tzrwI4c"
/>

<!-- Datos Estructurados (Schema.org) -->
{
  structuredData && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  )
}

<!-- Datos Estructurados Adicionales (múltiples schemas por página) -->
{
  additionalStructuredData && additionalStructuredData.map((schema) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  ))
}

{/*
  Directivas de rastreo. Un solo `robots`: no existen metas por bot para
  GPTBot/ClaudeBot/PerplexityBot y similares — el acceso de los crawlers de IA
  se controla en robots.txt y con la cabecera X-Robots-Tag, no aquí. Tampoco
  hacen falta `googlebot`/`bingbot`: ambos leen `robots`.
*/}
<meta
  name="robots"
  content={
    noindex
      ? "noindex, follow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>
