---
import { getLangFromUrl, translations } from "@/i18n";
import styles from "./HeroContact.module.css";

const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];
---

<section class={styles.hero} id="hero-contact">
  {/*
    Fuera el <img class={styles.vectorBg}>: apuntaba a Vector-hero-contact.svg,
    que responde 404 en R2. Era decorativo y aria-hidden, así que en producción
    ya se veía igual — solo costaba una petición fallida por visita.
  */}
  <img
    src="/decor/vector.svg"
    class={styles.headingVector}
    aria-hidden="true"
    alt=""
    loading="eager"
    decoding="async"
  />
  <div class={styles.container}>
    <h1 class={styles.heading}>
      <span class={styles.titleLine1} style="display: block;">{t.contact.hero.titleLine1}</span>
      <span class={styles.titleLine2} style="display: block;">{t.contact.hero.titleLine2}</span>
    </h1>

    <div class={styles.description}>
      <p>
        {t.contact.hero.description1}
        <br aria-hidden="true" />
        <br aria-hidden="true" />
        {t.contact.hero.description2}
      </p>
    </div>
  </div>
</section>
