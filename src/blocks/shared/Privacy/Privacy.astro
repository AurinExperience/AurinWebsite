---
import { translations } from '@/i18n';

import styles from './Privacy.module.css';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang].privacy;

type Section = { id?: string; title: string; paragraphs?: readonly string[]; list?: readonly string[]; after?: readonly string[] };
const sections: readonly Section[] = t.sections;
// Párrafos partidos en el correo, que se vuelve enlace
const split = (paragraphs: readonly string[]) => paragraphs.map((paragraph) => paragraph.split(t.contactEmail));
---

<section class={styles.privacyPage}>
  <div class={styles.privacyContainer}>
    <header class={styles.privacyHeader}>
      <h1 class={styles.privacyTitle}>{t.title}</h1>
      <p class={styles.privacySubtitle}>{t.lastUpdated}</p>
    </header>

    <div class={styles.privacyContent}>
      {sections.map(({ id, title, paragraphs = [], list = [], after = [] }) => (
        <section class={styles.privacySection} id={id}>
          <h2>{title}</h2>
          {split(paragraphs).map((parts) => (
            <p>{parts.map((part, i) => <>{i > 0 && <a href={`mailto:${t.contactEmail}`}>{t.contactEmail}</a>}{part}</>)}</p>
          ))}
          {list.length > 0 && <ul>{list.map((item) => <li>{item}</li>)}</ul>}
          {split(after).map((parts) => (
            <p>{parts.map((part, i) => <>{i > 0 && <a href={`mailto:${t.contactEmail}`}>{t.contactEmail}</a>}{part}</>)}</p>
          ))}
        </section>
      ))}
    </div>
  </div>
</section>
