---
import { getLangFromUrl } from "@/i18n";
import styles from "./SliderClients.module.css";

const lang = getLangFromUrl(Astro.url);

const LOGOS = [
  { src: "/logos/antojos-sabores.webp", name: "Antojos Sabores", height: 80, width: 80 },
  { src: "/logos/galicia.svg", name: "Galicia", height: 72, width: 96 },
  { src: "/logos/ingles-individual.webp", name: "Inglés Individual", height: 60, width: 94 },
  { src: "/logos/latiz.svg", name: "Latiz", height: 108, width: 108 },
  { src: "/logos/mexico-pacific.webp", name: "Mexico Pacific", height: 96, width: 96 },
  { src: "/logos/pinnacle.webp", name: "Pinnacle", height: 80, width: 94 },
  { src: "/logos/sinfonica-mineria.svg", name: "Sinfónica de Minería", height: 96, width: 96 },
  { src: "/logos/tio-francisco.webp", name: "Tío Francisco", height: 80, width: 80 },
  { src: "/logos/ancient.svg", name: "Ancient Wallets", height: 80, width: 106 },
  { src: "/logos/bonanza.svg", name: "Bonanza", height: 80, width: 94 },
  { src: "/logos/dentol.svg", name: "Dentol", height: 80, width: 94 },
  { src: "/logos/elite.svg", name: "Elite", height: 80, width: 94 },
  { src: "/logos/estrella.webp", name: "Estrella", height: 80, width: 80 },
  { src: "/logos/fruit.svg", name: "Fruit", height: 80, width: 69 },
  { src: "/logos/identidad.webp", name: "Identidad", height: 80, width: 94 },
  { src: "/logos/ideograma.svg", name: "Ideograma", height: 80, width: 106 },
  { src: "/logos/mexico.webp", name: "México", height: 80, width: 80 },
  { src: "/logos/monetix.svg", name: "Monetix", height: 80, width: 106 },
];

const ALL_LOGOS = [...LOGOS, ...LOGOS];
---

<section class={styles.slider} aria-label={lang === 'es' ? "Clientes de Aurin" : "Aurin clients"}>
  <div class={styles.track}>
    {
      ALL_LOGOS.map((logo, i) => (
        <>
          {/* La segunda vuelta solo existe para el loop visual: oculta para lectores y crawlers */}
          <div class={styles.logo} aria-hidden={i >= LOGOS.length ? 'true' : undefined}>
            <img
              src={logo.src}
              alt={i >= LOGOS.length ? '' : lang === 'es' ? `Logo de ${logo.name}` : `${logo.name} logo`}
              style={`height: calc(${logo.height}px * var(--logo-scale, 1))`}
              width={logo.width}
              height={logo.height}
              decoding="async"
              draggable="false"
            />
          </div>
          {(i + 1) % LOGOS.length !== 0 && <div class={styles.sep} />}
        </>
      ))
    }
  </div>
</section>
