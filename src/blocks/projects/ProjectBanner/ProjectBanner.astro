---
import styles from './ProjectBanner.module.css';

interface Props {
  title: string;
  categories: string[];
  clientLogo?: string;
  logoScale?: number;
  logoColor?: string;
}

const { title, categories, clientLogo, logoScale = 1, logoColor = 'white' } = Astro.props;
---

<section class={styles.banner}>
  <div class={styles.container}>
    <div class={styles.information}>
      {clientLogo && (
        <div class={styles.logoWrapper}>
          <img src={clientLogo} alt={`${title} logo`} class={styles.logoImage} data-color={logoColor} style={`--logo-scale: ${logoScale}`} />
        </div>
      )}
      
      <div class={styles.titleWrapper}>
        <h1 class={styles.title}>{title}</h1>
      </div>

      {categories && categories.length > 0 && (
        <div class={styles.categories}>
          {categories.map((category) => (
            <span class={styles.category}>{category}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

