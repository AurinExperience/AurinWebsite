---
/**
 * SocialProof — Real client trust signals.
 * Muestra trabajo real (imágenes de proyecto) + el marquee de logos de clientes.
 * Sin testimonios.
 *
 * ponytail: las imágenes van fijas, no por Payload. Hoy TODOS los proyectos del
 * CMS traen `placeholder-2.jpg` como banner, así que tirar de la API pintaba
 * cajas grises que decían "Proyecto Aurin". Cuando el CMS tenga banners reales,
 * esto se cambia por PayloadAPI.getFeaturedProjects().
 */
import type { LandingCopy, ProofProjectId } from '@/data/landings';
import { PROOF_PROJECTS } from '@/data/landings';
import { getLangFromUrl, getLocalizedUrl } from '@/i18n';
import SliderClients from '@/blocks/home/SliderClients/SliderClients.astro';
import styles from './SocialProof.module.css';

interface Props {
  socialProof: LandingCopy['socialProof'];
  /** Proyectos reales del CMS afines al sector que vende esta landing. */
  proof: ProofProjectId[];
}

const { socialProof, proof } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

/*
 * Solo existen tres imágenes de proyecto, así que las capturas se repiten entre
 * landings. Lo que sí cambia por estado es esta lista: son clientes reales,
 * elegidos por SECTOR, no por ubicación. Deliberadamente no dice de dónde son —
 * afirmarlo obligaría a sostener una cartera local que no existe.
 */
const proofProjects = proof.map((id) => PROOF_PROJECTS[id]).filter(Boolean);

const proofLabels =
  currentLang === 'es'
    ? {
        heading: 'Sectores en los que ya trabajamos',
        about: 'Quiénes somos y cómo trabajamos',
      }
    : {
        heading: 'Sectors we have already worked in',
        about: 'Who we are and how we work',
      };

const portfolioLabel =
  currentLang === 'es' ? 'Ver nuestro portafolio de proyectos' : 'See our project portfolio';

const work = [
  {
    src: '/work/galicia.webp',
    width: 1000,
    height: 661,
    name: 'Galicia',
    discipline: currentLang === 'es' ? 'UX/UI y desarrollo web' : 'UX/UI and web development',
  },
  {
    src: '/work/sinfonica.webp',
    width: 1000,
    height: 722,
    name: 'Sinfónica de Minería',
    discipline: currentLang === 'es' ? 'Branding y sitio web' : 'Branding and website',
  },
  {
    src: '/work/sai.webp',
    width: 1000,
    height: 551,
    name: 'SAI Derecho y Economía',
    discipline: currentLang === 'es' ? 'Diseño y desarrollo web' : 'Web design and development',
  },
];
---

<section class={styles.section} aria-labelledby="social-proof-heading">
  <div class={styles.inner}>
    <header class={styles.header}>
      <div>
        <h2 class={styles.heading} id="social-proof-heading">{socialProof.heading}</h2>
        <p class={styles.description}>{socialProof.description}</p>
      </div>
    </header>

    <ul class={styles.projects}>
      {work.map((item) => (
        <li class={styles.project}>
          <img
            class={styles.projectImage}
            src={item.src}
            alt={`${item.discipline} ${currentLang === 'es' ? 'para' : 'for'} ${item.name} — Aurin`}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
          />
          <div class={styles.projectMeta}>
            <span class={styles.projectName}>{item.name}</span>
            <span class={styles.projectDiscipline}>{item.discipline}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class={styles.sectors}>
      <h3 class={styles.sectorsHeading}>{proofLabels.heading}</h3>
      <ul class={styles.sectorsList}>
        {proofProjects.map((project) => (
          <li class={styles.sector}>
            <span class={styles.sectorName}>{project.name}</span>
            <span class={styles.sectorIndustry}>{project.sector[currentLang]}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class={styles.moreLinks}>
      <a class={styles.moreLink} href={getLocalizedUrl('/projects', currentLang)}>
        {portfolioLabel}
        <span aria-hidden="true">→</span>
      </a>
      {/* Enlace a la página de entidad: es la señal de E-E-A-T que le falta a
          una landing de captura, que por diseño no cuenta quién está detrás. */}
      <a class={styles.moreLink} href={getLocalizedUrl('/about', currentLang)}>
        {proofLabels.about}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  <SliderClients />
</section>
