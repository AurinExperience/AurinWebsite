---
/**
 * SocialProof — Real client trust signals.
 * Muestra el portafolio real (las mismas tarjetas de /projects, con los
 * proyectos del sector de la landing primero) en un slider. Los logos de
 * clientes van aparte, justo debajo del hero.
 * Sin testimonios.
 */
import type { LandingCopy, ProofProjectId } from '@/data/landings';
import { PROOF_PROJECTS } from '@/data/landings';
import { getLangFromUrl, getLocalizedUrl } from '@/i18n';
import { PayloadAPI } from '@/lib/payload';
import ProjectsGrid from '@/components/projects/ProjectsGrid.astro';
import styles from './SocialProof.module.css';

interface Props {
  socialProof: LandingCopy['socialProof'];
  /** Proyectos reales del CMS afines al sector que vende esta landing. */
  proof: ProofProjectId[];
}

const { socialProof, proof } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

/*
 * Solo los nombres de los sectores con clientes reales (los proyectos ya salen
 * en el slider), sin repetir y con los afines a esta landing primero. Se elige
 * por SECTOR, no por ubicación: afirmar de dónde son los clientes obligaría a
 * sostener una cartera local que no existe. Lo legal no se muestra (contrato).
 */
const sectorOrder = [
  ...proof,
  ...(Object.keys(PROOF_PROJECTS) as ProofProjectId[]).filter((id) => !proof.includes(id)),
];
const sectors = [
  ...new Set(
    sectorOrder
      .map((id) => PROOF_PROJECTS[id])
      .filter((project) => project && !/legal/i.test(project.sector.es))
      .map((project) => project.sector[currentLang]),
  ),
];

const proofLabels =
  currentLang === 'es'
    ? {
        heading: 'Sectores en los que ya trabajamos',
        about: 'Quiénes somos y cómo trabajamos',
      }
    : {
        heading: 'Sectors we have already worked in',
        about: 'Who we are and how we work',
      };

// Etiqueta de cada punto del slider: "Proyectos, página 2"
const dotLabel = currentLang === 'es' ? 'Proyectos, página' : 'Projects, page';

const portfolioLabel =
  currentLang === 'es' ? 'Ver nuestro portafolio de proyectos' : 'See our project portfolio';

// Proyectos de servicios legales: no se muestran en landings (contrato del estudio)
const LEGAL = /galicia|derecho/i;

/*
 * 6 proyectos: los afines al sector primero y el resto rotado según la página.
 * Con el portafolio completo en el mismo orden, las tarjetas eran el mismo texto
 * en todas las landings (contenido duplicado para Google). El completo sigue en /projects.
 */
const SHOWN = 6;
const cmsProjects = await PayloadAPI.getProjects(currentLang).catch(() => []);
const proofIds = proof.map((id) => PROOF_PROJECTS[id]?.cmsId);
const visible = cmsProjects.filter((p) => !LEGAL.test(p.title));
const related = proofIds.flatMap((id) => visible.filter((p) => p.id === id));
const rest = visible.filter((p) => !proofIds.includes(p.id));
const offset = rest.length ? [...Astro.url.pathname].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 0) % rest.length : 0;
const portfolio = [...related, ...rest.slice(offset), ...rest.slice(0, offset)].slice(0, SHOWN);
---

<section class={styles.section} aria-labelledby="social-proof-heading">
  <div class={styles.inner}>
    <header class={styles.header}>
      <div>
        <h2 class={styles.heading} id="social-proof-heading">{socialProof.heading}</h2>
        <p class={styles.description}>{socialProof.description}</p>
      </div>
    </header>

    {portfolio.length > 0 && (
      <div class={styles.slider} data-portfolio-slider data-dot-label={dotLabel}>
        <ProjectsGrid projects={portfolio} class={styles.portfolio} />
        <div class={styles.dots} data-dots data-dot-class={styles.dot}></div>
      </div>
    )}

    <div class={styles.sectors}>
      <h3 class={styles.sectorsHeading}>{proofLabels.heading}</h3>
      <ul class={styles.sectorsList}>
        {sectors.map((sector) => (
          <li class={styles.sector}>{sector}</li>
        ))}
      </ul>
    </div>

    <div class={styles.moreLinks}>
      <a class={styles.moreLink} href={getLocalizedUrl('/projects', currentLang)}>
        {portfolioLabel}
        <span aria-hidden="true">→</span>
      </a>
      {/* Enlace a la página de entidad: es la señal de E-E-A-T que le falta a
          una landing de captura, que por diseño no cuenta quién está detrás. */}
      <a class={styles.moreLink} href={getLocalizedUrl('/about', currentLang)}>
        {proofLabels.about}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Puntos del slider: uno por "página" (lo que cabe a la vista), se recalculan al
  // cambiar el ancho y marcan la página actual al deslizar.
  document.querySelectorAll<HTMLElement>('[data-portfolio-slider]').forEach((slider) => {
    // ProjectsGrid = contenedor > cuadrícula; la cuadrícula es la que se desliza
    const track = slider.firstElementChild?.firstElementChild as HTMLElement | null;
    const dots = slider.querySelector<HTMLElement>('[data-dots]');
    const card = track?.firstElementChild as HTMLElement | null;
    if (!track || !dots || !card) return;
    let step = 1;
    const max = () => track.scrollWidth - track.clientWidth;
    const update = () => {
      const current = track.scrollLeft >= max() - 1 ? dots.children.length - 1 : Math.round(track.scrollLeft / step);
      [...dots.children].forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
    };
    const build = () => {
      const cardStep = card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
      step = Math.max(1, Math.floor((track.clientWidth + cardStep - card.offsetWidth) / cardStep + 0.01)) * cardStep;
      const pages = max() > 1 ? 1 + Math.ceil(max() / step - 0.01) : 0;
      dots.replaceChildren(
        ...Array.from({ length: pages }, (_, i) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = dots.dataset.dotClass ?? '';
          dot.setAttribute('aria-label', `${slider.dataset.dotLabel} ${i + 1}`);
          dot.addEventListener('click', () => track.scrollTo({ left: i * step, behavior: 'smooth' }));
          return dot;
        }),
      );
      update();
    };
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', build);
    build();

    // Arrastre con mouse (con el dedo y el trackpad el scroll ya es nativo). Mientras
    // se arrastra se apaga el snap; al soltar se acomoda en la card más cercana.
    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    let moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) < 6) return;
      moved = true;
      track.dataset.dragging = '';
      track.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (!moved) return;
      const cardStep = card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
      track.scrollTo({ left: Math.round(track.scrollLeft / cardStep) * cardStep, behavior: 'smooth' });
      setTimeout(() => delete track.dataset.dragging, 400);
    });
    // Un arrastre no debe abrir el proyecto que quedó bajo el cursor
    track.addEventListener(
      'click',
      (e) => {
        if (moved) e.preventDefault();
        moved = false;
      },
      true,
    );
    track.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>
