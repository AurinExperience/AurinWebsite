---
/**
 * ServicesIncluded — Web design & UX/UI services offered on this landing.
 * H2/H3 hierarchy, numbered cards with feature bullets and contextual municipality mentions.
 */
import type { LandingCopy } from '@/data/landings';
import { getLangFromUrl, getLocalizedUrl } from '@/i18n';
import styles from './ServicesIncluded.module.css';

interface Props {
  services: LandingCopy['services'];
}

const { services } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const moreLabel =
  currentLang === 'es' ? 'Ver todos nuestros servicios' : 'See all our services';

// Los giros de cada landing son ejemplos, no el límite: esto va detrás del intro
// en todas para que nadie lea que solo atendemos esos sectores.
const anySector =
  currentLang === 'es'
    ? 'Estos son solo algunos ejemplos: nos adaptamos a casi cualquier sector.'
    : 'These are just a few examples: we adapt to almost any industry.';

// Las tarjetas mezclan contenido del sitio con funciones que son desarrollo; la
// etiqueta y esta nota dejan claro qué viene incluido y qué se cotiza aparte.
const hasCustom = services.items.some((s) => s.custom?.length);
const customTag = currentLang === 'es' ? 'A la medida' : 'Custom';
const customNote =
  currentLang === 'es'
    ? 'Todo sitio incluye formularios, WhatsApp, versión en español e inglés y descargables en PDF. Lo marcado como «A la medida» lo diseñamos y también desarrollamos su funcionalidad: se define contigo en la llamada y se cotiza aparte.'
    : 'Every site includes forms, WhatsApp, English and Spanish versions, and PDF downloads. Anything marked “Custom” we design and also build the functionality for: we define it with you on the call and quote it separately.';
---

<section class={styles.section} id="servicios-web" aria-labelledby="servicios-web-heading">
  <div class={styles.inner}>
    <header class={styles.header}>
      <h2 class={styles.heading} id="servicios-web-heading">{services.heading}</h2>
      <p class={styles.intro}>{services.intro} {anySector}</p>
    </header>

    <div class={styles.grid}>
      {services.items.map((service, index) => (
        <article class={styles.card}>
          <span class={styles.index} aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class={styles.cardTitle}>{service.title}</h3>
          <p class={styles.cardDescription}>{service.description}</p>
          <ul class={styles.bullets}>
            {service.bullets.map((bullet) => (
              <li class={styles.bullet}>{bullet}</li>
            ))}
            {service.custom?.map((bullet) => (
              <li class={styles.bullet}>
                {bullet} <span class={styles.customTag}>{customTag}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    {hasCustom && <p class={styles.customNote}>{customNote}</p>}

    <a class={styles.moreLink} href={getLocalizedUrl('/services', currentLang)}>
      {moreLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
