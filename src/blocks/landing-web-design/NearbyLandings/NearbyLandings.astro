---
/**
 * NearbyLandings — Enlaces a las otras landings por ciudad.
 *
 * Existe por dos razones de SEO, no de diseño:
 * 1. Sin enlaces internos las landings nuevas quedarían huérfanas: solo el
 *    sitemap las anunciaría y Google les daría poca autoridad.
 * 2. El anchor text nombra la otra ciudad explícitamente ("Diseño web en
 *    Querétaro"), que es la señal más directa de que cada página cubre una
 *    intención de búsqueda distinta y no compite contra sus hermanas.
 *
 * Va después del formulario a propósito: la landing es de captura, así que las
 * salidas de la página quedan por debajo del punto de conversión.
 */
import type { Lang, Landing, LandingCopy } from '@/data/landings';
import { landingPath, landingPlace, siblingLandings } from '@/data/landings';
import styles from './NearbyLandings.module.css';

interface Props {
  /** La landing por ciudad actual: se listan las demás del mismo país. */
  landing?: Landing;
  /** Enlaces ya armados (landings por sector), incluida la página actual. Tienen prioridad sobre `landing`. */
  links?: { href: string; label: string }[];
  lang: Lang;
  nearby: LandingCopy['nearby'];
}

const { landing, links, lang, nearby } = Astro.props;
// Orden alfabético por el lugar que se lee en el enlace ("…en Houston" → "Houston"),
// no por la etiqueta completa, que cambia de prefijo entre landings.
const all =
  links ??
  (landing ? [landing, ...siblingLandings(landing)] : [])
    .sort((a, b) => landingPlace(a, lang).localeCompare(landingPlace(b, lang), lang, { sensitivity: 'base' }))
    .map((l) => ({ href: landingPath(l, lang), label: l.copy[lang].linkLabel }));

/*
 * Solo las RING siguientes en orden alfabético (en anillo), no todas: con decenas
 * de enlaces iguales en cada landing, ese bloque era casi todo el texto repetido
 * entre landings. En anillo cada landing sigue recibiendo RING enlaces internos,
 * así ninguna queda huérfana.
 */
const RING = 8;
const here = all.findIndex((item) => item.href === Astro.url.pathname);
const items = Array.from(
  { length: Math.min(RING, all.length - 1) },
  (_, k) => all[(here + 1 + k) % all.length],
);
// `links` solo llega desde las landings por sector; sin él son ciudades
const showAll = links
  ? lang === 'es' ? 'Ver más sectores' : 'See more industries'
  : lang === 'es' ? 'Ver más ciudades' : 'See more cities';
---

{items.length > 0 && (
<section class={styles.section} aria-labelledby="nearby-heading">
  <div class={styles.inner}>
    <div class={styles.header}>
      <h2 class={styles.heading} id="nearby-heading">{nearby.heading}</h2>
      <p class={styles.description}>{nearby.description}</p>
    </div>
    {/* Cerrado por defecto: son decenas de enlaces y abiertos alargaban el final de
        la landing. Siguen en el HTML, así que Google los rastrea igual. */}
    <details class={styles.more}>
      <summary class={styles.summary}>
        {showAll}
      </summary>
      <ul class={styles.list}>
        {items.map((item) => (
          <li>
            <a class={styles.link} href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</section>
)}
