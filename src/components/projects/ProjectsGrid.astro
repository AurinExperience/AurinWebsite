---
import { getLangFromUrl } from '@/i18n';
import ProjectCard from '@/components/cards/ProjectCard.astro';

import { getProjectUrl, getImageUrl, ownCardImage, getCardCover, getCategorySlugs, NO_PHOTO_IMAGE, type PayloadProject } from '@/lib/payload';
import styles from './ProjectsGrid.module.css';

interface Props {
  /** Los trae ProjectsList, que se los pasa también a FilterPills */
  projects: PayloadProject[];
  maxProjects?: number;
  showHeader?: boolean;
  headerTitle?: string;
  class?: string;
}

const { 
  projects: allProjects,
  maxProjects,
  showHeader = false,
  headerTitle = '',
  class: className = ''
} = Astro.props;

// Detect current language
const currentLang = getLangFromUrl(Astro.url);

const projects = maxProjects ? allProjects.slice(0, maxProjects) : allProjects;
---

<div class={`${styles.projectsGridContainer} ${className}`}>
  {showHeader && headerTitle && (
    <div class={styles.headerSection}>
      <h2 class={styles.gridTitle}>{headerTitle}</h2>
    </div>
  )}
  
  <div class={styles.projectsGrid}>
    {projects.length > 0 ? (
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          tags={[
            ...(project.category ? [project.category.name] : []),
            ...(project.tags?.slice(0, 2).map((tag: any) => tag.name) || [])
          ]}
          image={getImageUrl(ownCardImage(project, allProjects)?.url) || NO_PHOTO_IMAGE}
          cover={getCardCover(project)}
          href={getProjectUrl(project, currentLang)}
          category={project.category?.slug}
          services={project.hero.services || []}
          filters={getCategorySlugs(project)}
        />
      ))
    ) : (
      <div class={styles.emptyState}>
        <p class={styles.emptyMessage}>
          {currentLang === 'es' ? 'No hay proyectos disponibles en este momento.' : 'No projects available at the moment.'}
        </p>
      </div>
    )}
  </div>
</div>
