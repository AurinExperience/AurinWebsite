---
import ArrowUpRight from 'lucide-astro/ArrowUpRight';
import styles from './ProjectCard.module.css';
import { Tilt } from '@/components/animation/Tilt';
import { NO_PHOTO_IMAGE, type CardCover } from '@/lib/payload';

interface Props {
  title: string;
  tags?: string[];
  image: string;
  /** Alt de la imagen en el CMS; si no viene, el título del proyecto */
  alt?: string;
  /** Texto del CMS sobre color; si viene, ocupa el lugar de la imagen */
  cover?: CardCover;
  href?: string;
  class?: string;
  category?: string;
  services?: Array<{ name: string }>;
  filters?: string[];
  showChips?: boolean;
}

const {
  title,
  tags = [],
  image,
  alt,
  cover,
  href = '#',
  class: className = '',
  category,
  services = [],
  filters = [],
  showChips = true
} = Astro.props;

const uniqueId = `project-card-${Math.random().toString(36).substr(2, 9)}`;

const allTags = [...(tags || []), ...(services ? services.map(s => s.name) : [])];
// Una sola etiqueta visible; el resto aparece en el tooltip al pasar el mouse
const displayTags = allTags.slice(0, 1);
const remainingCount = allTags.length - displayTags.length;
const hiddenTags = allTags.slice(displayTags.length);
---

<a href={href} class={`${styles['project-card']} ${className}`} data-card-id={uniqueId} data-project-card data-category={category} data-filters={JSON.stringify(filters)}>
  {remainingCount > 0 && (
    <div class={styles['tooltip']} data-tooltip>
      {hiddenTags.join(' • ')}
    </div>
  )}
  <div class={styles['card-content']}>
    <!-- Image container -->
    <Tilt 
      client:visible
      rotationFactor={2}
      className="w-full h-full rounded-lg overflow-hidden"
      style={{ transformOrigin: 'center center' }}
    >
      {cover ? (
        // Colores del CMS como variables (validados como hex en getCardCover)
        <div
          class:list={[styles['image-container'], styles['text-cover']]}
          style={`--cover-bg: ${cover.background}; --cover-fg: ${cover.color}; --cover-weight: ${cover.weight}`}
          data-size={cover.size}
          data-font={cover.font}
        >
          <div class={styles['cover-text']} data-cover-text set:html={cover.html} />
        </div>
      ) : (
        // <img> y no background-image: así lleva alt y Google la indexa
        <div class={styles['image-container']}>
          <img
            class={styles['image']}
            src={image}
            alt={image === NO_PHOTO_IMAGE ? '' : alt || title.replace(/<[^>]+>/g, ' ')}
            loading="lazy"
            decoding="async"
          />
          <div class={styles['image-overlay']}></div>
        </div>
      )}
    </Tilt>
    
    <!-- Info section -->
    <div class={styles['info-section']}>
      <div class={styles['info-content']}>
        <h3 class={styles['project-title']} set:html={title}></h3>

        {displayTags.length > 0 && (
          <div class={styles['tags-container']}>
            {displayTags.map((tag) => (
              <div class={styles['tag-item']}>
                <div class={styles['tag-dot']}></div>
                <div class={styles['tag-text']}>{tag}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Arrow button -->
      <div class={styles['arrow-button']} data-arrow-button>
        <ArrowUpRight size={16.67} strokeWidth={2.5} />
      </div>
    </div>
  </div>
</a>

<script is:inline>
  (function() {
    function initProjectCards() {
      const cards = document.querySelectorAll('[data-card-id]');
      
      cards.forEach((card) => {
        const arrowButton = card.querySelector('[data-arrow-button]');
        
        if (!arrowButton) return;
        
        // Sincronizar hover
        const handleEnter = () => card.classList.add('is-hovering');
        const handleLeave = () => card.classList.remove('is-hovering');
        
        arrowButton.addEventListener('mouseenter', handleEnter);
        arrowButton.addEventListener('mouseleave', handleLeave);
      });

      // Animación de scroll con IntersectionObserver
      const observerOptions = {
        threshold: 0.2,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      cards.forEach((card, index) => {
        // Delay más rápido para mejor UX
        card.style.transitionDelay = `${index * 0.08}s`;
        observer.observe(card);

        // Tooltip logic
        const tooltip = card.querySelector('[data-tooltip]');
        if (tooltip) {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            let x = e.clientX - rect.left;
            let y = e.clientY - rect.top - 20; // 20px above cursor

            // Boundary limits to prevent sticking out
            const tw = tooltip.offsetWidth;
            const th = tooltip.offsetHeight;
            const padding = 10;

            // X is centered (-50%), so the left edge is x - tw/2, right edge is x + tw/2
            const minX = (tw / 2) + padding;
            const maxX = rect.width - (tw / 2) - padding;
            x = Math.max(minX, Math.min(x, maxX));

            // Y is bottom-aligned (-100%), so top edge is y - th, bottom edge is y
            const minY = th + padding;
            const maxY = rect.height - padding;
            y = Math.max(minY, Math.min(y, maxY));

            tooltip.style.transform = `translate(-50%, -100%) translate(${x}px, ${y}px)`;
          });
        }
      });
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectCards);
    } else {
      initProjectCards();
    }
    
    // Soporte para view transitions de Astro
    document.addEventListener('astro:page-load', initProjectCards);
  })();
</script>

<script>
  // Texto de la tarjeta (CMS): que se lea bien sin cortar palabras.
  //  1. Ningún renglón con una sola palabra: se pega a la vecina con un espacio no
  //     separable (NBSP), siempre que el renglón siga cabiendo.
  //  2. Si no se logra, o el texto es más alto que la tarjeta, la letra baja 5 % y se
  //     vuelve a intentar.
  // Todo escala con la tarjeta (cqi): los cortes salen iguales en cualquier ancho, así
  // que basta con hacerlo una vez, ya con las fuentes cargadas.
  const NBSP = '\u00a0';

  type Word = { top: number; spaceBefore?: [Text, number] };

  // Palabras de un párrafo = tramos sin espacios, aunque crucen etiquetas ("manos</em>?")
  const wordsOf = (paragraph: HTMLElement) => {
    const words: Word[] = [];
    let lastSpace: [Text, number] | undefined;
    let inWord = false;
    const walker = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT);
    for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
      for (let i = 0; i < node.data.length; i++) {
        if (/\s/.test(node.data[i])) {
          // Solo un espacio normal se puede pegar (un NBSP ya está pegado)
          lastSpace = node.data[i] === ' ' ? [node, i] : undefined;
          inWord = false;
        } else if (!inWord) {
          inWord = true;
          const range = document.createRange();
          range.setStart(node, i);
          range.setEnd(node, i + 1);
          words.push({ top: Math.round(range.getBoundingClientRect().top), spaceBefore: words.length ? lastSpace : undefined });
        }
      }
    }
    return words;
  };

  const overflows = (el: HTMLElement) => el.scrollWidth > el.clientWidth + 1;

  // true si el párrafo queda sin palabras solas y sin salirse a lo ancho
  const joinLonelyWords = (paragraph: HTMLElement) => {
    for (let pass = 0; pass < 20; pass++) {
      if (overflows(paragraph)) return false;
      const words = wordsOf(paragraph);
      if (words.length < 2) return true;
      const lonely = words.findIndex((word, i) => words[i - 1]?.top !== word.top && words[i + 1]?.top !== word.top);
      if (lonely === -1) return true;
      // La primera palabra se pega a la siguiente; las demás, a la anterior
      const space = (lonely === 0 ? words[1] : words[lonely]).spaceBefore;
      if (!space) return false;
      const [node, index] = space;
      node.data = node.data.slice(0, index) + NBSP + node.data.slice(index + 1);
    }
    return false;
  };

  const fitCoverText = (cover: HTMLElement) => {
    const original = cover.innerHTML;
    // De 100 % a 50 % en pasos de 5 % (enteros: sumar 0.05 acumula error de redondeo)
    for (let step = 0; step <= 10; step++) {
      cover.innerHTML = original;
      cover.style.setProperty('--cover-fit', String(1 - step * 0.05));
      const paragraphs = [...cover.querySelectorAll<HTMLElement>('p')];
      if (paragraphs.every(joinLonelyWords) && cover.scrollHeight <= cover.clientHeight + 1) return;
    }
    // Ni al 50 % se logra: el texto sin pegar, que al menos no se sale ni parte palabras
    cover.innerHTML = original;
  };

  document.fonts.ready.then(() => {
    document.querySelectorAll<HTMLElement>('[data-cover-text]').forEach(fitCoverText);
  });
</script>
