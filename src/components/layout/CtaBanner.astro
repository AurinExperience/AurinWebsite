---
import { getLangFromUrl, translations } from '@/i18n';
import SecondaryButton from '@/components/ui/SecondaryButton.astro';
import CtaVector from './CtaVector.astro';

import styles from './CtaBanner.module.css';
import { Tilt } from '@/components/animation/Tilt';

// Detect current language and page context
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

// Determine page context based on URL pathname
const pathname = Astro.url.pathname;
let pageContext = 'home';

if (pathname.includes('/about') || pathname.includes('/us')) {
  pageContext = 'us';
} else if (pathname.includes('/services') || pathname.includes('/services')) {
  pageContext = 'services';
} else if (pathname.includes('/projects') || pathname.includes('/projects') || pathname.includes('/proyecto/')) {
  pageContext = 'projects';
}

// Get context-specific content
const ctaBannerContent = (t.ctaBanner as any)[pageContext] || (t.ctaBanner as any).home;
---

<section class={styles.ctaBannerContainer}>
  <!-- client:media en vez de client:visible: el tilt sigue al cursor, así que en
       táctil no hace nada. Con esto el runtime de React + framer-motion (~108 KB)
       deja de descargarse en móvil. -->
  <Tilt 
    client:media="(pointer: fine)"
    rotationFactor={1.5}
    className="w-full"
    style={{ transformOrigin: 'center center' }}
  >
    <div class={styles.ctaBannerWrapper} data-parallax-wrapper>
      <div class={styles.ctaBannerContent}>
        <div class={styles.ctaBannerDecoration}>
          <CtaVector />
        </div>
        <div class={styles.ctaBannerText}>
          <p set:html={ctaBannerContent.text}></p>
        </div>
        <div class={styles.buttonWrapper}>
          <SecondaryButton text={ctaBannerContent.buttonText} href="/contact" />
        </div>
      </div>
    </div>
  </Tilt>
</section>

<script>
  // `motion` se importa en diferido y solo cuando el banner se acerca al viewport:
  // vive al final de la página, no tiene por qué competir con el LCP.
  const wrapper = document.querySelector('[data-parallax-wrapper]') as HTMLElement | null;

  if (wrapper && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      import('motion').then(({ scroll, animate }) => {
        scroll(animate(wrapper, { y: [0, -50] }), {
          target: wrapper,
          offset: ['start end', 'end start'],
        });
      });
    }, { rootMargin: '400px' }).observe(wrapper);
  }
</script>
