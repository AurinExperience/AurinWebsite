---
/**
 * ContactPage — Shared page template for the contact page.
 * Used by both src/pages/contact.astro (ES) and src/pages/en/contact.astro (EN).
 * Language is detected automatically from the URL.
 */
import type { ContactPageStructuredData } from "@/types/seo";
import { SITE } from "@/config/site";
import { getLangFromUrl, getCanonicalUrl, translations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import HeroContact from "@/blocks/shared/Contact/HeroContact.astro";
import Form from "@/blocks/shared/Contact/Form.astro";
import Toast from "@/components/ui/Toast.astro";

// Detect current language from URL automatically
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const seoTitle = t.contact.seo.title;
const seoDescription = t.contact.seo.description;
const seoKeywords = t.contact.seo.keywords;

/**
 * Apunta al Organization global (GlobalSchema.astro) por @id en vez de volver a
 * declararlo. Antes esta página emitía un segundo nodo Organization con datos
 * distintos —incluido `addressLocality: "Aldea Creativa"`, que es el nombre del
 * coworking y no una localidad—, así que Google veía dos entidades en conflicto.
 * La dirección real vive en SITE.address y la publica el schema global.
 */
const structuredData: ContactPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: seoTitle,
  url: getCanonicalUrl(SITE.url, "/contact", currentLang),
  mainEntity: { "@id": `${SITE.url}/#organization` },
};

const canonicalUrl = getCanonicalUrl(SITE.url, "/contact", currentLang);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
  canonical={canonicalUrl}
  ogImage={SITE.ogImage}
>
  <Header />
  <main id="main-content">
    <HeroContact />
    <Form />
    <Toast />
    <Footer />
  </main>
</Layout>
