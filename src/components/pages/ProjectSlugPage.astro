---
/**
 * ProjectSlugPage — Shared page template for individual project detail pages.
 * Used by both src/pages/project/[slug].astro (ES)
 * and src/pages/en/project/[slug].astro (EN).
 * Language is detected automatically from the URL.
 *
 * Recibe el proyecto ya resuelto: las páginas [slug] responden 404 si no
 * existe y 503 si Payload falla, así que aquí nunca hay datos de relleno.
 */
import { SITE } from "@/config/site";
import { getLangFromUrl, getCanonicalUrl, translations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CtaBanner from "@/components/layout/CtaBanner.astro";
import Vignette from "@/components/ui/Vignette.astro";
import Template from "@/blocks/shared/Template/Template.astro";
import DynamicProjects from "@/components/projects/DynamicProjects.astro";
import { metaDescription } from "@/lib/seo";
import {
  type HreflangAlternate,
  projectPageUrl,
  resolveProjectOgImage,
  toProjectData,
} from "@/lib/project-page";
import { type PayloadProject, PAYLOAD_SERVER_URL } from "@/lib/payload";

interface Props {
  project: PayloadProject;
  sibling?: PayloadProject;
  alternateLinks?: HreflangAlternate[];
  /** Live preview del admin: sin indexar y redibuja la Template con lo que se escribe en el formulario */
  preview?: boolean;
}

const { project, sibling, alternateLinks, preview = false } = Astro.props;

// Detect current language from URL automatically
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const projectData = toProjectData(project);

// SEO
const seoTitleSuffix = currentLang === "es" ? "| Portafolio Aurin" : "| Aurin Design Portfolio";
// Los campos de la pestaña SEO del CMS mandan; vacíos, se arman del contenido
const seoTitle = project.seo?.metaTitle?.trim() || `${projectData.projectTitle} ${seoTitleSuffix}`;
const fallbackDesc =
  currentLang === "es"
    ? "Caso de éxito: proyecto de diseño estratégico creado por Aurin, agencia de comunicación visual en México."
    : "Case study: strategic design project by Aurin, a visual communication agency based in Mexico.";
const seoDescription =
  project.seo?.metaDescription?.trim() || metaDescription(projectData.projectDescription) || fallbackDesc;
// Google ignora meta keywords; se dejan los servicios reales del proyecto para otros buscadores
const seoKeywords = [...projectData.projectCategories, projectData.clientName, "Aurin"].filter(Boolean).join(", ");

// El slug puede traer espacios o acentos ("Fruit Academy"): se codifica igual que en el sitemap
const canonicalUrl = getCanonicalUrl(SITE.url, `/project/${encodeURIComponent(project.slug)}`, currentLang);

const ogImage = resolveProjectOgImage(project);
const schemaImage = ogImage !== SITE.ogImage ? ogImage : undefined;

// CreativeWork con Aurin como autor: es lo que deja a un buscador o a una IA
// responder "¿quién hizo el sitio de X?" o "¿qué agencias tienen casos de fintech?".
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonicalUrl}#work`,
  name: projectData.projectTitle,
  description: seoDescription,
  url: canonicalUrl,
  inLanguage: currentLang === "es" ? "es-MX" : "en-US",
  ...(schemaImage && { image: schemaImage }),
  ...(projectData.projectCategories.length && {
    genre: projectData.projectCategories,
    keywords: projectData.projectCategories.join(", "),
  }),
  ...(project.publishDate && { datePublished: project.publishDate }),
  ...(project.updatedAt && { dateModified: project.updatedAt }),
  ...(projectData.clientName && {
    // El cliente para quien se hizo: es lo que permite responder "¿quién hizo el sitio de X?"
    sourceOrganization: {
      "@type": "Organization",
      name: projectData.clientName,
      ...(project.client?.industry && { description: project.client.industry }),
      ...(project.website && { url: project.website }),
    },
  }),
  ...(project.website && { workExample: { "@type": "WebSite", url: project.website } }),
  isPartOf: { "@type": "CollectionPage", url: `${SITE.url}${currentLang === "es" ? "/projects" : "/en/projects"}` },
  mainEntityOfPage: canonicalUrl,
  creator: { "@id": `${SITE.url}/#organization` },
  publisher: { "@id": `${SITE.url}/#organization` },
};

const portfolioPath = currentLang === "es" ? "/projects" : "/en/projects";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: currentLang === "es" ? "Inicio" : "Home", item: getCanonicalUrl(SITE.url, "/", currentLang) },
    { "@type": "ListItem", position: 2, name: currentLang === "es" ? "Portafolio" : "Portfolio", item: `${SITE.url}${portfolioPath}` },
    { "@type": "ListItem", position: 3, name: projectData.projectTitle, item: canonicalUrl },
  ],
};

const languageAlternateHref = sibling
  ? projectPageUrl(sibling, currentLang === "es" ? "en" : "es")
  : undefined;

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
  additionalStructuredData={[breadcrumbSchema]}
  canonical={canonicalUrl}
  alternateLinks={alternateLinks}
  ogImage={ogImage}
  ogType="article"
  noindex={preview}
>
  <Vignette intensity="medium" />
  <Header languageAlternateHref={languageAlternateHref} />
  <main id="main-content">
    {preview ? (
      <div id="project-preview">
        <Template projectData={projectData} />
      </div>
    ) : (
      <Template projectData={projectData} />
    )}
    <CtaBanner />
    <DynamicProjects maxProjects={4} showChips={false} variant="four-column" />
    <Footer />
  </main>
  {preview && (
    <script
      is:inline
      define:vars={{
        // Mismos orígenes del admin que el CORS de aurin-cms. Solo ellos pueden mandar HTML a esta página.
        cmsOrigins: [
          new URL(PAYLOAD_SERVER_URL).origin,
          "https://admin.aurin.mx",
          "https://www.admin.aurin.mx",
          ...(import.meta.env.DEV ? ["http://localhost:3000"] : []),
        ],
      }}
    >
      const root = document.getElementById("project-preview");
      const admin = window.opener || window.parent;
      let timer;
      let controller;

      window.addEventListener("message", (event) => {
        if (!cmsOrigins.includes(event.origin)) return;
        if (event.data?.type !== "payload-live-preview" || !event.data.data) return;
        clearTimeout(timer);
        timer = setTimeout(async () => {
          controller?.abort();
          controller = new AbortController();
          try {
            const res = await fetch("/preview/project-partial", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(event.data.data),
              signal: controller.signal,
            });
            // createContextualFragment (no innerHTML) para que el carrusel de React vuelva a hidratarse
            if (res.ok) root.replaceChildren(document.createRange().createContextualFragment(await res.text()));
          } catch {
            // Cancelado por una edición más nueva
          }
        }, 300);
      });

      // Le avisa al admin que ya puede mandar los datos del formulario. Solo al origen que
      // abrió el preview (referrer): a los demás Safari llena la consola de errores.
      const opener = cmsOrigins.find((origin) => document.referrer.startsWith(origin));
      if (admin !== window) {
        for (const origin of opener ? [opener] : cmsOrigins) admin.postMessage({ type: "payload-live-preview", ready: true }, origin);
      }
    </script>
  )}
</Layout>
