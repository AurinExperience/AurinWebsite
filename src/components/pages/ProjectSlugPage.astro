---
/**
 * ProjectSlugPage — Shared page template for individual project detail pages.
 * Used by both src/pages/project/[slug].astro (ES)
 * and src/pages/en/project/[slug].astro (EN).
 * Language is detected automatically from the URL.
 *
 * Recibe el proyecto ya resuelto: las páginas [slug] responden 404 si no
 * existe y 503 si Payload falla, así que aquí nunca hay datos de relleno.
 */
import { SITE } from "@/config/site";
import { getLangFromUrl, getCanonicalUrl, translations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CtaBanner from "@/components/layout/CtaBanner.astro";
import Vignette from "@/components/ui/Vignette.astro";
import Template from "@/blocks/shared/Template/Template.astro";
import DynamicProjects from "@/components/projects/DynamicProjects.astro";
import { metaDescription } from "@/lib/seo";
import {
  type PayloadProject,
  getImageUrl,
  renderRichText,
  renderRichTextHeadings,
  renderRichTextBody,
} from "@/lib/payload";

interface Props {
  project: PayloadProject;
}

const { project } = Astro.props;

// Detect current language from URL automatically
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

// Transform Payload project to template format
const projectData = {
  projectTitle: project.title,
  projectCategories:
    project.hero.services?.map((service) => service.name) || [],
  projectDescription: renderRichText(project.hero.description),
  descriptionHeading: renderRichTextHeadings(project.hero.description),
  descriptionBody: renderRichTextBody(project.hero.description),
  clientLogo: getImageUrl(project.client?.logo?.url),
  clientName: project.client?.name,
  clientIndustry: project.client?.industry,
  heroImage: getImageUrl(project.hero.bannerImage?.url),
  gallery:
    project.gallery?.map((item) => ({
      imgUrl: getImageUrl(item.image?.url),
      alt: item.alt || project.title,
    })) || [],
};

// SEO
const seoTitleSuffix = currentLang === "es" ? "| Portafolio Aurin" : "| Aurin Design Portfolio";
const seoTitle = `${projectData.projectTitle} ${seoTitleSuffix}`;
const fallbackDesc =
  currentLang === "es"
    ? "Caso de éxito: proyecto de diseño estratégico creado por Aurin, agencia de comunicación visual en México."
    : "Case study: strategic design project by Aurin, a visual communication agency based in Mexico.";
const seoDescription = metaDescription(projectData.projectDescription) || fallbackDesc;
const seoKeywords =
  currentLang === "es"
    ? "proyecto diseño Aurin, caso éxito branding, identidad corporativa México, portafolio agencia creativa"
    : "design project Aurin, branding case study, corporate identity Mexico, creative agency portfolio";

// El slug puede traer espacios o acentos ("Fruit Academy"): se codifica igual que en el sitemap
const canonicalUrl = getCanonicalUrl(SITE.url, `/project/${encodeURIComponent(project.slug)}`, currentLang);

/* ponytail: sin imagen del proyecto en OG ni en el schema. Los banners de
   Payload hoy son casi todos placeholders (800x600-…, Image-400x300-…); usar
   project.hero.bannerImage aquí cuando el CMS tenga imágenes reales. */
// CreativeWork con Aurin como autor: es lo que deja a un buscador o a una IA
// responder "¿quién hizo el sitio de X?" o "¿qué agencias tienen casos de fintech?".
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonicalUrl}#work`,
  name: projectData.projectTitle,
  description: seoDescription,
  url: canonicalUrl,
  inLanguage: currentLang === "es" ? "es-MX" : "en",
  ...(projectData.projectCategories.length && { genre: projectData.projectCategories }),
  ...(projectData.clientName && {
    sourceOrganization: { "@type": "Organization", name: projectData.clientName },
  }),
  creator: { "@id": `${SITE.url}/#organization` },
};

const portfolioPath = currentLang === "es" ? "/projects" : "/en/projects";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: currentLang === "es" ? "Inicio" : "Home", item: getCanonicalUrl(SITE.url, "/", currentLang) },
    { "@type": "ListItem", position: 2, name: currentLang === "es" ? "Portafolio" : "Portfolio", item: `${SITE.url}${portfolioPath}` },
    { "@type": "ListItem", position: 3, name: projectData.projectTitle, item: canonicalUrl },
  ],
};

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
  additionalStructuredData={[breadcrumbSchema]}
  canonical={canonicalUrl}
  ogImage={SITE.ogImage}
>
  <Vignette intensity="medium" />
  <Header />
  <main id="main-content">
    <Template projectData={projectData} />
    <DynamicProjects maxProjects={3} showChips={false} />
    <CtaBanner />
    <Footer />
  </main>
</Layout>
