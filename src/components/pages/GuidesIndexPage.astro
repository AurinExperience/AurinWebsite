---
/**
 * GuidesIndexPage — índice de la sección de guías, en los dos idiomas.
 *
 * Es la puerta de entrada del cluster: sin una página que las agrupe, cada guía
 * dependería solo del sitemap para ser descubierta.
 */
import type { BreadcrumbListStructuredData, WebPageStructuredData } from '@/types/seo';
import { GUIDES, guidePath, guidesIndexPath } from '@/data/guides';
import { publishedLandings, landingPath, landingPlace } from '@/data/landings';
import { publishedSectors, sectorPath } from '@/data/sectors';
import { SITE } from '@/config/site';
import { getLangFromUrl } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import styles from './GuidesIndexPage.module.css';

const lang = getLangFromUrl(Astro.url);
const canonicalUrl = `${SITE.url}${guidesIndexPath[lang]}`;

/* Mismo cálculo que en la guía: 200 palabras por minuto. */
const readingMinutes = (guide: (typeof GUIDES)[number]) => {
  const copy = guide.copy[lang];
  const words = [
    ...copy.intro,
    ...copy.sections.flatMap((section) => [
      section.heading,
      ...section.paragraphs,
      ...(section.bullets ?? []),
    ]),
  ]
    .join(' ')
    .split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
};

const t =
  lang === 'es'
    ? {
        title: 'Guías de diseño web y UX/UI | Aurin',
        description:
          'Guías prácticas sobre costos, contratación, rediseño y sitios bilingües, escritas para quien tiene que tomar la decisión y no para quien ya sabe de esto.',
        keywords:
          'guías diseño web, costo página web, elegir agencia web, rediseño web SEO, sitio web bilingüe',
        heading: 'Guías',
        intro:
          'Lo que nos preguntan una y otra vez antes de empezar un proyecto, respondido completo. Sin tecnicismos innecesarios y sin vender en cada párrafo.',
        read: 'Leer la guía',
        minutes: 'min de lectura',
        locationsHeading: 'Diseño web por ubicación',
        locationsIntro:
          'Trabajamos a distancia con todo México y con empresas en Estados Unidos. Cada página explica cómo trabajamos en ese lugar y para qué tipo de negocios.',
        mx: 'México',
        us: 'Estados Unidos',
        sectorsHeading: 'Diseño web y UX/UI por sector',
        sectorsIntro:
          'Páginas pensadas para lo que necesita cada tipo de negocio, en México y en Estados Unidos, sin importar en qué ciudad esté.',
      }
    : {
        title: 'Web design and UX/UI guides | Aurin',
        description:
          'Practical guides on cost, hiring, redesign, and bilingual sites, written for the person who has to make the decision rather than for someone who already knows.',
        keywords:
          'web design guides, website cost, choosing a web agency, redesign SEO, bilingual website',
        heading: 'Guides',
        intro:
          'What we get asked over and over before starting a project, answered in full. No unnecessary jargon and no selling in every paragraph.',
        read: 'Read the guide',
        minutes: 'min read',
        locationsHeading: 'Web design by location',
        locationsIntro:
          'We work remotely across Mexico and with companies in the United States. Each page explains how we work in that place and for which kinds of businesses.',
        mx: 'Mexico',
        us: 'United States',
        sectorsHeading: 'Web and UX/UI design by industry',
        sectorsIntro: 'Pages built around what each kind of business needs, in Mexico and the United States, wherever it is located.',
      };

/*
 * Directorio de landings por país. El footer ya no enlaza las landings, así que
 * este índice es lo que deja a todas a dos clics de cualquier página del sitio
 * (footer → guías → landing); cada guía solo enlaza a tres.
 */
const landings = publishedLandings();
type LandingItem = (typeof landings)[number];

/*
 * México se lista por estado (`region`: Monterrey → Nuevo León, Los Cabos →
 * Baja California Sur), para que la lista no mezcle estados con municipios.
 * EE. UU. va por ciudad: tres de las cinco son de Texas.
 */
const isUS = (landing: LandingItem) => landing.country === 'US';
const label = (landing: LandingItem) => (isUS(landing) ? landingPlace(landing, lang) : landing.region);
const byLabel = (a: LandingItem, b: LandingItem) =>
  label(a).localeCompare(label(b), lang, { sensitivity: 'base' });

const locationGroups = [
  { id: 'mx', label: t.mx, items: landings.filter((l) => !isUS(l)).sort(byLabel) },
  { id: 'us', label: t.us, items: landings.filter(isUS).sort(byLabel) },
].filter((group) => group.items.length > 0);

const sectors = publishedSectors().sort((a, b) =>
  a.name[lang].localeCompare(b.name[lang], lang, { sensitivity: 'base' })
);
/* Por país, como las ubicaciones: los sectores de EE. UU. son para clientes de allá */
const sectorGroups = [
  { id: 'mx', label: t.mx, items: sectors.filter((s) => s.country !== 'US') },
  { id: 'us', label: t.us, items: sectors.filter((s) => s.country === 'US') },
].filter((group) => group.items.length > 0);

const webPageSchema: WebPageStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.heading,
  description: t.description,
  url: canonicalUrl,
  provider: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchema: BreadcrumbListStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: lang === 'es' ? 'Inicio' : 'Home',
      item: lang === 'es' ? SITE.url : `${SITE.url}/en`,
    },
    { '@type': 'ListItem', position: 2, name: t.heading, item: canonicalUrl },
  ],
};
---

<Layout
  title={t.title}
  description={t.description}
  keywords={t.keywords}
  structuredData={webPageSchema}
  additionalStructuredData={[breadcrumbSchema]}
  canonical={canonicalUrl}
  ogImage={SITE.ogImage}
>
  <Header />
  <main id="main-content" class={styles.main}>
    <div class={styles.inner}>
      <header class={styles.header}>
        <h1 class={styles.heading}>{t.heading}</h1>
        <p class={styles.intro}>{t.intro}</p>
      </header>

      <ul class={styles.list}>
        {GUIDES.map((guide, index) => (
          <li class={styles.item}>
            <a class={styles.itemLink} href={guidePath(guide, lang)}>
              <span class={styles.itemIndex} aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class={styles.itemTitle}>{guide.copy[lang].title}</h2>
              <p class={styles.itemExcerpt}>{guide.copy[lang].excerpt}</p>
              <span class={styles.itemFooter}>
                <span class={styles.itemCta}>
                  {t.read}
                  <span aria-hidden="true">→</span>
                </span>
                <span class={styles.itemMinutes}>
                  {readingMinutes(guide)} {t.minutes}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <section class={styles.locations} aria-labelledby="locations-heading">
        <header class={styles.locationsHeader}>
          <h2 class={styles.locationsHeading} id="locations-heading">{t.locationsHeading}</h2>
          <p class={styles.locationsIntro}>{t.locationsIntro}</p>
        </header>
        <div class={styles.locationGroups}>
          {locationGroups.map((group) => (
            <div class={styles.locationGroup} data-country={group.id}>
              <h3 class={styles.locationGroupHeading}>
                {group.label}
                <span class={styles.locationCount}>{group.items.length}</span>
              </h3>
              <ul class={styles.locationList}>
                {group.items.map((landing) => (
                  <li>
                    <a
                      class={styles.locationLink}
                      href={landingPath(landing, lang)}
                      title={landing.copy[lang].linkLabel}
                    >
                      <span>
                        {label(landing)}{isUS(landing) && (
                          <span class={styles.locationRegion}>{`, ${landing.region}`}</span>
                        )}
                      </span>
                      <span class={styles.locationArrow} aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      {sectors.length > 0 && (
        <section class={styles.locations} aria-labelledby="sectors-heading">
          <header class={styles.locationsHeader}>
            <h2 class={styles.locationsHeading} id="sectors-heading">{t.sectorsHeading}</h2>
            <p class={styles.locationsIntro}>{t.sectorsIntro}</p>
          </header>
          <div class:list={[styles.locationGroups, styles.sectorGroups]}>
            {sectorGroups.map((group) => (
              <div class={styles.locationGroup} data-country={group.id}>
                <h3 class={styles.locationGroupHeading}>
                  {group.label}
                  <span class={styles.locationCount}>{group.items.length}</span>
                </h3>
                <ul class={styles.locationList}>
                  {group.items.map((sector) => (
                    <li>
                      <a
                        class={styles.locationLink}
                        href={sectorPath(sector, lang)}
                        title={sector.copy[lang].linkLabel}
                      >
                        <span>{sector.name[lang]}</span>
                        <span class={styles.locationArrow} aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <Footer />
</Layout>
