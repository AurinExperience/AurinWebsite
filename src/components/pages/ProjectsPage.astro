---
/**
 * ProjectsPage — Shared page template for the projects/portfolio page.
 * Used by both src/pages/projects.astro (ES) and src/pages/en/projects.astro (EN).
 * Language is detected automatically from the URL.
 */
import type { CollectionPageStructuredData } from "@/types/seo";
import { SITE } from "@/config/site";
import { getLangFromUrl, getCanonicalUrl, translations } from "@/i18n";
import HeroProjects from "@/blocks/projects/HeroProjects/HeroProjects.astro";
import ProjectsList from "@/blocks/projects/ProjectsList/ProjectsList.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Banner from "@/components/layout/CtaBanner.astro";

// Detect current language from URL automatically
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const seoTitle = t.projects.seo.title;
const seoDescription = t.projects.seo.description;
const seoKeywords = t.projects.seo.keywords;

const canonicalUrl = getCanonicalUrl(SITE.url, "/projects", currentLang);

const portfolioName =
  currentLang === "es"
    ? "Portfolio de Proyectos - Aurin"
    : "Project Portfolio - Aurin";

/**
 * El OfferCatalog que había aquí declaraba tres CreativeWork con títulos
 * genéricos de traducción ("proyecto-innovador-1", "transformacion-digital",
 * "experiencia-usuario") que no corresponden a ningún proyecto de la página:
 * los proyectos reales vienen de Payload y cada uno tiene su propia página con
 * su schema. Describir contenido que no existe en la página es justo lo que
 * Google penaliza, así que el catálogo se va y la colección apunta al
 * Organization global por @id.
 */
const structuredData: CollectionPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: portfolioName,
  description: seoDescription,
  url: canonicalUrl,
  inLanguage: currentLang === "es" ? "es-MX" : "en-US",
  mainEntity: { "@id": `${SITE.url}/#organization` },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
  canonical={canonicalUrl}
  ogImage={SITE.ogImage}
>
  <Header />
  <main id="main-content">
    <HeroProjects />
    <ProjectsList />
    <Banner />
    <Footer />
  </main>
</Layout>
