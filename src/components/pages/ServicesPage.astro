---
/**
 * ServicesPage — Shared page template for the services page.
 * Used by both src/pages/services.astro (ES) and src/pages/en/services.astro (EN).
 * Language is detected automatically from the URL.
 */
import type { ServiceStructuredData } from "@/types/seo";
import { faqSchema } from "@/lib/seo";
import { SITE } from "@/config/site";
import { getLangFromUrl, getCanonicalUrl, translations } from "@/i18n";
import { GUIDES, guidePath } from "@/data/guides";
import { HeroServices, CardServices, ToolsScrollStory, HowWeWork } from "@/blocks/services";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CtaBanner from "@/components/layout/CtaBanner.astro";
import DynamicProjects from "@/components/projects/DynamicProjects.astro";
import FaqSection from "@/blocks/landing-web-design/FaqSection/FaqSection.astro";

// Detect current language from URL automatically
const currentLang = getLangFromUrl(Astro.url);
const t = translations[currentLang];

const seoTitle = t.services.seo.title;
const seoDescription = t.services.seo.description;
const seoKeywords = t.services.seo.keywords;

const serviceTypeLabel =
  currentLang === "es"
    ? "Diseño web, desarrollo web y diseño UX/UI"
    : "Web design, web development and UX/UI design";

const catalogName =
  currentLang === "es"
    ? "Servicios de diseño web, desarrollo y UX/UI"
    : "Web design, development and UX/UI services";

const structuredData: ServiceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: serviceTypeLabel,
  provider: { "@id": `${SITE.url}/#organization` },
  areaServed: ["MX", "US", "CA", "ES", "DO", "PR", "PA", "CR", "CL", "UY"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: catalogName,
    itemListElement: t.services.servicesList.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.description,
      },
    })),
  },
};

const canonicalUrl = getCanonicalUrl(SITE.url, "/services", currentLang);

/* Las guías responden lo que se pregunta antes de contratar (costo, cómo elegir
   agencia, rediseño): enlazarlas desde aquí reparte autoridad hacia ellas y le
   da a Servicios contexto temático. */
const guideLinks = GUIDES.map((g) => ({ label: g.copy[currentLang].title, href: guidePath(g, currentLang) }));
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={structuredData}
  additionalStructuredData={[faqSchema(t.services.faq.items)]}
  canonical={canonicalUrl}
  ogImage={SITE.ogImage}
>
  <Header />
  <main id="main-content">
    <HeroServices />
    <CardServices />
    <ToolsScrollStory />
    <HowWeWork />
    <FaqSection faq={t.services.faq} links={guideLinks} />
    <CtaBanner />
    <DynamicProjects maxProjects={4} showChips={false} variant="four-column" />
    <Footer />
  </main>
</Layout>
