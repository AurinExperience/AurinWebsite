---
import ButtonIsland from './ButtonIsland.astro';
import { Tilt } from '@/components/animation/Tilt';

interface Props {
  text?: string;
  type?: 'button' | 'submit' | 'reset';
  onClick?: string;
  disabled?: boolean;
  class?: string;
  href?: string;
}

const props = Astro.props;
---

{/*
  El CTA principal vive above the fold, así que `client:visible` hidrataba React
  + framer-motion (~108 KB) en la ruta crítica: era el 4.4 s de "retraso de
  renderizado" del LCP. El tilt sigue al cursor, o sea que en táctil nunca hacía
  nada — con `client:media` el móvil ni siquiera descarga el runtime.
*/}
<Tilt
  client:media="(pointer: fine)"
  rotationFactor={1.5}
  style={{ transformOrigin: 'center center' }}
>
  <ButtonIsland {...props} variant="primary" />
</Tilt>
