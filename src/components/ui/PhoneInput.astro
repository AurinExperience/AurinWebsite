---
/**
 * PhoneInput — teléfono con selector de lada internacional.
 * Trae todos los países: los mercados de Aurin arriba y el resto por nombre
 * (src/lib/phoneCountries.ts). El <select> nativo va invisible encima de una
 * etiqueta corta ("🇲🇽 +52"): la lista abierta muestra nombres sin ensanchar el campo.
 * La lada se preselecciona en el navegador con la región de su idioma (es-CO → +57)
 * y si no, México. No se usa el país de la IP: obligaría al CDN a guardar una copia
 * de cada página por país (más SSR y más CPU).
 * Los nombres van en el atributo `label` y no como texto de la <option>: el
 * navegador los muestra igual, pero 2 selectores × 257 países eran ~1,900
 * palabras idénticas en cada página y Google las leía como contenido duplicado.
 * Si el usuario pega un número con "+XX", la lada se ajusta sola.
 * Solo admite dígitos (y separadores), no deja pasar del largo del país, los
 * espacia como se escriben allá ("777 123 4567") y revisa que lada y número
 * existan (src/lib/phone.ts).
 * Envía dos campos: `${name}` (número nacional) y `${name}Lada` ("+52").
 */
import { getLangFromUrl, translations } from '@/i18n';
import { phoneCountries } from '@/lib/phoneCountries';
import styles from './PhoneInput.module.css';

interface Props {
  id: string;
  name: string;
  placeholder?: string;
  /** Clases del formulario anfitrión, para heredar su look. */
  inputClass?: string;
  selectClass?: string;
}

const { id, name, placeholder, inputClass, selectClass } = Astro.props;

const phoneError = translations[getLangFromUrl(Astro.url)].contact.form.phoneError;

const { main, rest } = phoneCountries(getLangFromUrl(Astro.url));
const mx = main[0];

---

<div class={styles.wrapper} data-phone-input>
  <div class={styles.lada}>
    <span class:list={[selectClass, styles.ladaShown]} aria-hidden="true" data-lada-shown>{mx.flag} {mx.dial}</span>
    <select
      class={styles.ladaSelect}
      name={`${name}Lada`}
      aria-label="Lada"
      autocomplete="tel-country-code"
    >
      {main.map((c) => (
        <option value={c.dial} label={`${c.name} ${c.dial} ${c.flag}`} data-country={c.code} data-digits={c.digits} data-primary={c.primary || undefined} selected={c === mx} />
      ))}
      <option value="" label="──────────" disabled />
      {rest.map((c) => (
        <option value={c.dial} label={`${c.name} ${c.dial} ${c.flag}`} data-country={c.code} data-digits={c.digits} data-primary={c.primary || undefined} />
      ))}
    </select>
  </div>
  <input
    class:list={[inputClass, styles.number]}
    type="tel"
    id={id}
    name={name}
    placeholder={placeholder}
    autocomplete="tel-national"
    inputmode="tel"
    data-error={phoneError}
    required
  />
</div>

<script>
  import type { CountryCode } from 'libphonenumber-js/min';

  document.querySelectorAll<HTMLElement>('[data-phone-input]').forEach((wrapper) => {
    const select = wrapper.querySelector('select')!;
    const input = wrapper.querySelector('input')!;
    const shown = wrapper.querySelector<HTMLElement>('[data-lada-shown]')!;
    const options = [...select.options].filter((o) => o.value);
    const showLada = () => {
      const option = select.selectedOptions[0];
      // La bandera va al final: al inicio rompería buscar país tecleando ("alem").
      shown.textContent = `${option.label.match(/\p{Regional_Indicator}{2}/u)?.[0] ?? ''} ${option.value}`;
    };

    // Región del idioma del navegador (es-MX, en-US…); sin coincidencia queda México.
    const region = navigator.languages
      .map((lang) => lang.split('-')[1]?.toUpperCase())
      .find((r) => r && options.some((o) => o.dataset.country === r));
    const match = options.find((o) => o.dataset.country === region);
    if (match) match.selected = true;
    showLada();

    // La librería de numeración pesa: se descarga hasta que alguien escribe, no en cada página.
    let phone: Promise<typeof import('@/lib/phone')> | undefined;
    const update = async (reformat: boolean) => {
      const { isValidPhone, formatPhone } = await (phone ??= import('@/lib/phone'));
      const option = select.selectedOptions[0];
      const country = option.dataset.country as CountryCode;

      if (reformat && input.value && !input.value.startsWith('+')) {
        const focused = document.activeElement === input;
        // El cursor vuelve a quedar tras el mismo número de dígitos.
        const digitsBefore = input.value.slice(0, input.selectionStart ?? undefined).replace(/\D/g, '').length;
        const formatted = formatPhone(input.value, country);
        if (formatted !== input.value) {
          input.value = formatted;
          if (focused) {
            let pos = 0;
            for (let seen = 0; pos < formatted.length && seen < digitsBefore; pos++) {
              if (/\d/.test(formatted[pos])) seen++;
            }
            input.setSelectionRange(pos, pos);
          }
        }
      }

      const [min, max] = option.dataset.digits!.split('-');
      const length = input.value.replace(/\D/g, '').replace(/^0/, '').length;
      const ok =
        !input.value ||
        (length >= Number(min) &&
          length <= Number(max) &&
          isValidPhone(input.value, country));
      input.setCustomValidity(
        ok ? '' : input.dataset.error!.replace('{lada}', option.value).replace('{n}', min === max ? min : `${min}–${max}`),
      );
    };

    input.addEventListener('input', (e) => {
      // Solo dígitos, separadores y el "+" de una lada pegada: nada de letras.
      const clean = input.value.replace(/[^\d\s()\-+]/g, '');
      if (clean !== input.value) input.value = clean;

      // "+34 612…" pegado o tecleado: mover la lada al selector.
      const raw = input.value.trim();
      if (raw.startsWith('+')) {
        const digits = raw.replace(/[^\d]/g, '');
        const match = options
          .filter((o) => digits.startsWith(o.value.slice(1)))
          .sort(
            (a, b) =>
              b.value.length - a.value.length ||
              Number('primary' in b.dataset) - Number('primary' in a.dataset),
          )[0];
        if (match) {
          match.selected = true;
          showLada();
          input.value = digits.slice(match.value.length - 1);
        }
      }

      // Tope del país: los dígitos de más no entran. Un 0 inicial (marcación
      // nacional, "099…" en Ecuador) no cuenta. Con "+" a medias aún no hay país.
      if (!input.value.startsWith('+')) {
        // "+52 1 55…" (prefijo de celular viejo, común al copiar de WhatsApp): en
        // México ningún número empieza con 1, así que ese 1 sobra.
        if (select.selectedOptions[0].dataset.country === 'MX' && /^\D*1/.test(input.value)) {
          input.value = input.value.replace(/^(\D*)1\D*/, '$1');
        }
        const max = Number(select.selectedOptions[0].dataset.digits!.split('-')[1]);
        const keep = max + (/^\D*0/.test(input.value) ? 1 : 0);
        let count = 0;
        const capped = input.value.replace(/\d/g, (d) => (++count > keep ? '' : d));
        if (capped !== input.value) input.value = capped;
      }
      // Al borrar no se reacomoda: si no, el espacio borrado reaparece y el cursor se atora.
      update(!(e as InputEvent).inputType?.startsWith('delete'));
    });
    input.addEventListener('blur', () => update(true));
    select.addEventListener('change', () => {
      showLada();
      update(true);
    });
  });
</script>
